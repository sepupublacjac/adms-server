# === Koneksi ke database Postgres yang SUDAH ADA ===
# Kalau Postgres jalan di HOST (bukan di dalam docker-compose ini):
#  - Linux            -> pakai host.docker.internal (sudah di-setup lewat extra_hosts)
#  - Docker Desktop    -> host.docker.internal juga jalan otomatis
#  - Postgres di server lain -> isi IP/hostname server itu langsung
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ganti_ini
DB_NAME=nama_database_kamu

# === Tabel & kolom tujuan (sudah kamu siapkan sendiri, tidak di-CREATE oleh server ini) ===
ATTENDANCE_TABLE=adms_logs
COL_PIN=user_id
COL_TIMESTAMP=date
COL_STATUS=check_logs
COL_DEVICE_SN=device_sn

# Kosongkan (hapus baris / biarkan kosong) kalau tabelmu tidak punya kolom ini
COL_VERIFY_TYPE=
COL_WORKCODE=
COL_RAW_LINE=

# === Lain-lain ===
# Port yang di-expose di host, ini juga port yang diisi di mesin attendance
APP_PORT=8080

# Log request mentah dari mesin ke stdout container (docker compose logs -f app)
LOG_RAW_REQUESTS=true

# === Workaround bug firmware: jam mesin bergeser maju setelah push ke ADMS ===
# Kalau mesin kamu kena bug ini (RTC bergeser +1 jam / 3599 detik setiap
# push), isi angka detiknya di sini -- akan otomatis dikurangkan dari
# timestamp ATTLOG sebelum disimpan ke adms_logs. Isi 0 kalau tidak perlu.
ATTLOG_TIME_CORRECTION_SECONDS=3599
